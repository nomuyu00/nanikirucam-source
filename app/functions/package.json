{
  "name": "nanikiru-cam-functions",
  "version": "0.1.0",
  "private": true,
  "description": "なにきるカム（仮）のバックエンド（Firebase Functions 2nd gen）",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src test",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-nanikiru-cam \"jest --config jest.emulator.config.js --runInBand\"",
    "test:e2e": "npm run build && firebase emulators:exec --config ../firebase.json --only auth,functions,firestore,storage --project demo-nanikiru-cam \"jest --config jest.e2e.config.js --runInBand\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}

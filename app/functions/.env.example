# Functions の設定値。`.env.nanikiru-cam`（プロジェクト ID を付けた名前）にコピーして書き換える。
# ここに秘密情報は書かない（秘密情報は `firebase functions:secrets:set 名前` で Secret Manager に登録する）。
# 値を書かなければ、config.ts の既定値が使われる。

# 公開 URL（Hosting のオリジン。末尾スラッシュなし）。独自ドメインにしたら変える。
SITE_URL=https://nanikiru-cam.web.app

# ストア。App Store の ID（数字）が空のあいだは、Web 問題ページに iOS ボタンを出さない。
IOS_APP_STORE_ID=
# App Store Connect のキャンペーンリンクのプロバイダトークン（pt）。空なら pt/ct を付けない。
IOS_PROVIDER_TOKEN=
ANDROID_PACKAGE=jp.aile.nanikiru_cam

# Web 問題ページの GA4 測定 ID（G-XXXXXXXXXX）。空なら読み込まない。
GA4_MEASUREMENT_ID=

# callable に App Check を必須にする（クライアントに App Check を入れてから true にする）。
ENFORCE_APP_CHECK=false

# 自動投稿
BLUESKY_HANDLE=
THREADS_USER_ID=
# X（有料 API）。使うときだけ true にし、Secret X_CREDENTIALS を登録する。
X_ENABLED=false

# Secret（`firebase functions:secrets:set <NAME>`）。未使用の投稿先は `-` を登録する。
#   REVENUECAT_WEBHOOK_SECRET   RevenueCat の Webhook「Authorization header value」と同じ値
#   BLUESKY_APP_PASSWORD        Bluesky のアプリパスワード
#   THREADS_ACCESS_TOKEN        Threads の長期アクセストークン（以後は 30 日ごとに自動更新される）
#   DISCORD_WEBHOOK_URL         Discord の Webhook URL
#   X_CREDENTIALS               {"apiKey":"...","apiSecret":"...","accessToken":"...","accessSecret":"..."}
